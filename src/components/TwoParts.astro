---
interface Part {
  number: string;
  name: string;
  time: string;
  venue: string;
  address: string;
  ticket: string;
  note: string;
  href: string;
  action: string;
  tone: string;
}

interface Props { parts: Part[] }
const { parts } = Astro.props;
---

<section class="parts" id="parts">
  <div class="heading">
    <p class="section-label">[ 002 / ONE NIGHT, TWO PARTS ]</p>
    <h2>Choose your<br /><em>route.</em></h2>
  </div>
  <div class="part-list">
    {parts.map((part) => (
      <article class:list={['part', `part-${part.tone}`]}>
        <div class="number">{part.number}</div>
        <div class="part-name"><span>{part.name}</span><strong>{part.time}</strong></div>
        <div class="venue"><strong>{part.venue}</strong><p>{part.address}</p></div>
        <div class="ticket"><span>{part.ticket}</span><p>{part.note}</p></div>
        <a href={part.href} class="part-link" data-magnet target={part.href.startsWith('http') ? '_blank' : undefined} rel={part.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{part.action} <b>↗</b></a>
      </article>
    ))}
  </div>
</section>

<style>
  .parts { background: var(--paper); color: var(--ink); padding: clamp(3rem, 8vw, 8rem) 1.25rem; }
  .heading, .part-list { margin: 0 auto; max-width: 1320px; }
  .heading { align-items: end; display: flex; justify-content: space-between; margin-bottom: clamp(2.5rem, 6vw, 5rem); }
  .section-label { font-size: .7rem; font-weight: bold; letter-spacing: .12em; margin: 0; }
  h2 { font-family: var(--display); font-size: clamp(4rem, 9vw, 8rem); font-weight: 400; letter-spacing: -.04em; line-height: .78; margin: 0; text-align: right; text-transform: uppercase; }
  h2 em { color: var(--red); font-style: normal; }
  .part-list { border-top: 2px solid var(--ink); }
  .part { align-items: center; border-bottom: 2px solid var(--ink); display: grid; gap: 1.2rem; grid-template-columns: .25fr .9fr 1.05fr 1.25fr .7fr; padding: 1.3rem 0; }
  .number { color: var(--red); font-family: var(--display); font-size: 3rem; }
  .part-name { display: flex; flex-direction: column; gap: .25rem; text-transform: uppercase; }
  .part-name span { font-size: .72rem; font-weight: bold; letter-spacing: .12em; }
  .part-name strong, .venue strong { font-family: var(--display); font-size: clamp(1.8rem, 3vw, 3.4rem); font-weight: 400; letter-spacing: -.02em; line-height: .85; }
  .venue p, .ticket p { font-size: .82rem; line-height: 1.2; margin: .4rem 0 0; }
  .ticket span { background: var(--acid); display: inline-block; font-size: .7rem; font-weight: bold; letter-spacing: .07em; padding: .2rem .35rem; text-transform: uppercase; }
  .part-red .ticket span { background: var(--red); color: var(--paper); }
  .part-link { align-items: center; border: 1px solid var(--ink); display: flex; font-size: .7rem; font-weight: bold; gap: .5rem; justify-content: space-between; letter-spacing: .07em; padding: .7rem; text-decoration: none; text-transform: uppercase; transition: background .2s, color .2s; }
  .part-link:hover { background: var(--ink); color: var(--paper); }
  .part-link b { font-size: 1.1rem; }
  @media (max-width: 860px) { .part { align-items: start; grid-template-columns: 2.5rem 1fr; } .part-name, .venue, .ticket, .part-link { grid-column: 2; } .part-link { width: max-content; } }
  @media (max-width: 520px) { .heading { align-items: start; flex-direction: column; gap: 2rem; } h2 { text-align: left; } }
</style>
