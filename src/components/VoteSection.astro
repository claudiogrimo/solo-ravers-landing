---
import { event } from '../data/event';

interface Props {
  announceAtIso?: string;
  winner?: string;
}

const {
  announceAtIso = event.voteClosesAtIso,
  winner = event.contestWinner,
} = Astro.props;
---

<section class="vote" id="vote" data-vote-gate data-vote-announce-at={announceAtIso} data-vote-state="pending">
  <div class="vote-intro vote-pending" data-vote-pending>
    <p class="section-label">[ 004 / COMMUNITY VOTE — CLOSED ]</p>
    <h2>THE VOTE IS <span>CLOSED.</span></h2>
    <p>14 sets ranked, the community has decided.</p>
    <p>Stay close. The winner of the opening slot will be revealed right here.</p>
    <p class="vote-countdown" role="timer" aria-live="polite">
      <span class="vote-countdown-label">Winner revealed in</span>
      <strong data-vote-countdown>21:30 (Amsterdam)</strong>
    </p>
  </div>

  <div class="vote-intro vote-announced" data-vote-announced hidden>
    <p class="section-label">[ 004 / COMMUNITY VOTE — CLOSED ]</p>
    <h2>THE VOTE IS <span>CLOSED.</span></h2>
    <p>Thanks for ranking the sets. <strong>{winner}</strong> takes the opening slot at The Return of Solo Ravers Invite.</p>
    <p>{winner} joins the full lineup in Amsterdam. See who else is playing.</p>
    <a class="vote-cta" href="#lineup">Back to the lineup <b>↘</b></a>
  </div>
</section>

<script>
  import { initVoteGate } from '../scripts/vote-gate.js';

  initVoteGate();
</script>

<style>
  .vote { background: var(--paper); color: var(--ink); padding: clamp(3rem, 8vw, 8rem) 1.25rem; }
  .vote-intro { margin: 0 auto; max-width: 1320px; display: grid; gap: 1.5rem; grid-template-columns: .55fr 1.45fr 1fr; }
  .vote-intro[hidden] { display: none; }
  .section-label { font-size: .7rem; font-weight: bold; letter-spacing: .12em; margin: 0; }
  h2 { font-family: var(--display); font-size: clamp(3.5rem, 6.5vw, 7rem); font-weight: 400; letter-spacing: -.04em; line-height: .78; margin: 0; text-transform: uppercase; }
  h2 span { color: var(--red); }
  .vote-intro p:not(.section-label) { font-size: 1rem; line-height: 1.25; margin: 0; }
  .vote-intro strong { color: var(--red); }
  .vote-countdown { display: grid; gap: .3rem; }
  .vote-countdown-label { font-size: .68rem; font-weight: bold; letter-spacing: .12em; text-transform: uppercase; }
  .vote-countdown strong { color: var(--ink); font-family: var(--display); font-size: clamp(1.8rem, 2.6vw, 2.6rem); font-weight: 400; letter-spacing: -.02em; line-height: 1; text-transform: uppercase; }
  .vote-cta { align-items: center; background: var(--red); color: var(--paper); display: flex; font-size: .78rem; font-weight: bold; justify-content: space-between; letter-spacing: .08em; margin-top: .5rem; padding: .9rem 1rem; text-decoration: none; text-transform: uppercase; width: 100%; }
  .vote-cta b { font-size: 1.15rem; }
  @media (max-width: 860px) { .vote-intro { grid-template-columns: 1fr; } }
</style>
