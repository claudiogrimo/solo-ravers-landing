---
interface Props { artists: string[] }
const { artists } = Astro.props;
---

<section class="lineup" id="lineup">
  <div class="lineup-head">
    <p class="section-label">[ 003 / LINEUP ]</p>
    <p>SELECTORS FOR THE RETURN</p>
  </div>
  <ol>
    {artists.map((artist, index) => (
      <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{artist}</strong><i>↘</i></li>
    ))}
  </ol>
</section>

<style>
  .lineup { padding: clamp(3rem, 8vw, 8rem) 1.25rem; }
  .lineup-head, ol { margin: 0 auto; max-width: 1320px; }
  .lineup-head { display: flex; font-size: .7rem; font-weight: bold; justify-content: space-between; letter-spacing: .12em; }
  .lineup-head p { margin: 0; }
  .section-label { color: var(--acid); }
  ol { border-top: 1px solid var(--line); list-style: none; margin-top: 2rem; padding: 0; }
  li { align-items: center; border-bottom: 1px solid var(--line); display: grid; grid-template-columns: .2fr 1fr .1fr; padding: .85rem 0; }
  li span { color: var(--acid); font-size: .74rem; font-weight: bold; }
  li strong { font-family: var(--display); font-size: clamp(3.2rem, 9vw, 9.5rem); font-weight: 400; letter-spacing: -.04em; line-height: .8; text-transform: uppercase; }
  li i { color: var(--muted); font-size: 1.4rem; font-style: normal; text-align: right; }
</style>
