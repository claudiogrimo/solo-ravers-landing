---
interface Player {
  artist: string;
  src: string;
}

interface Slot {
  name: string;
  slot: string;
  winner?: boolean;
  b2b?: boolean;
  b2bGroup?: string | null;
}

interface Props {
  lineup: Slot[];
  players?: Player[];
  winner?: string;
  winnerPlaceholder?: string;
  announceAtIso?: string;
}

const {
  lineup,
  players = [],
  winner,
  winnerPlaceholder = 'TBA',
  announceAtIso,
} = Astro.props;

// A slot can embed the set(s) of the artist(s) it covers: for a solo slot we match the
// player by its artist name, for a b2b slot ("Clodol b2b oatmilk") we collect every
// player whose artist appears in the slot name.
const slotPlayers = (slot: Slot) =>
  players.filter((player) => slot.name.toLowerCase().includes(player.artist.toLowerCase()));

// The winner slot renders the placeholder server-side. It is revealed at `announceAtIso`
// by the shared winner gate (see src/scripts/vote-gate.js), which reads the winner name
// from `data-lineup-winner-name`. `data-lineup-winner` marks the element to swap.
---

<section class="lineup" id="lineup">
  <div class="lineup-head">
    <p class="section-label">[ 003 / LINEUP ]</p>
    <p>SELECTORS FOR THE RETURN</p>
  </div>
  <ol>
    {lineup.map((slot, index) => {
      const embeds = slotPlayers(slot);

      return (
        <li class:list={{ 'has-player': embeds.length > 0, 'is-b2b': slot.b2b, 'is-winner': slot.winner }} data-stagger-item>
          <div class="artist-row">
            <span class="artist-index">{String(index + 1).padStart(2, '0')}</span>
            <span class="artist-name">{slot.winner
              ? <strong data-lineup-winner data-lineup-winner-name={winner} data-announce-at={announceAtIso}>{winnerPlaceholder}</strong>
              : <strong>{slot.name}</strong>}
              {slot.b2b && <em class="b2b-tag">b2b</em>}</span>
            <em class="slot-time">{slot.slot}</em>
          </div>
          {embeds.map((player) => (
            <iframe
              title={`${player.artist} DJ set`}
              width="100%"
              height="166"
              scrolling="no"
              frameborder="no"
              allow="autoplay; encrypted-media"
              src={player.src}
            ></iframe>
          ))}
        </li>
      );
    })}
  </ol>
</section>

<script>
  import { initVoteGate } from '../scripts/vote-gate.js';

  initVoteGate();
</script>

<style>
  .lineup { padding: clamp(3rem, 8vw, 8rem) 1.25rem; }
  .lineup-head, ol { margin: 0 auto; max-width: 1320px; }
  .lineup-head { display: flex; font-size: .7rem; font-weight: bold; justify-content: space-between; letter-spacing: .12em; }
  .lineup-head p { margin: 0; }
  .section-label { color: var(--acid); }
  ol { border-top: 1px solid var(--line); list-style: none; margin-top: 2rem; padding: 0; }
  li { border-bottom: 1px solid var(--line); padding: .85rem 0; }
  .is-b2b { padding-left: 1.1rem; position: relative; }
  .is-b2b::before {
    background: var(--acid);
    bottom: 0;
    content: '';
    left: 0;
    position: absolute;
    top: 0;
    width: 8px;
  }
  .artist-row { align-items: start; display: grid; column-gap: 1.5rem; grid-template-columns: 1.6rem 1fr auto; position: relative; }
  .artist-index { color: var(--acid); font-size: .74rem; font-weight: bold; padding-top: .35rem; }
  .artist-name { align-items: flex-start; display: flex; gap: .8rem; min-width: 0; }
  li strong { font-family: var(--display); font-size: clamp(3.2rem, 9vw, 9.5rem); font-weight: 400; letter-spacing: -.04em; line-height: .8; text-transform: uppercase; }
  .b2b-tag {
    background: var(--acid);
    color: var(--ink);
    font-size: .62rem;
    font-style: normal;
    font-weight: bold;
    letter-spacing: .1em;
    line-height: 1;
    margin-top: .5rem;
    padding: .32rem .42rem;
    text-transform: uppercase;
  }
  .slot-time { color: var(--muted); font-size: .82rem; font-style: normal; font-weight: bold; letter-spacing: .1em; padding-top: .5rem; white-space: nowrap; }
  .has-player { padding-bottom: 1rem; }
  iframe { border: 0; display: block; margin: 1rem 0 0; width: 100%; }
</style>
