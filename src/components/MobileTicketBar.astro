---
interface Props {
  ticketUrl: string;
  date: string;
  ticketHref?: string;
  ticketExternal?: boolean;
}
const { ticketUrl, date, ticketHref = ticketUrl, ticketExternal = true } = Astro.props;
---

<aside class="mobile-ticket-bar" aria-label="Ticket shortcut">
  <a href={ticketHref} target={ticketExternal ? '_blank' : undefined} rel={ticketExternal ? 'noopener noreferrer' : undefined}>Get tickets <b>{ticketExternal ? '↗' : '↓'}</b></a>
</aside>

<style>
  .mobile-ticket-bar { display: none; }
  @media (max-width: 760px) {
    .mobile-ticket-bar {
      background: var(--ink);
      border-top: 1px solid var(--line);
      bottom: 0;
      display: flex;
      left: 0;
      padding: .55rem .7rem;
      position: fixed;
      right: 0;
      z-index: 50;
    }
    .mobile-ticket-bar a {
      align-items: center;
      background: var(--acid);
      color: var(--ink);
      display: flex;
      font-size: .82rem;
      font-weight: bold;
      gap: .6rem;
      justify-content: center;
      letter-spacing: .06em;
      padding: .8rem 1rem;
      text-decoration: none;
      text-transform: uppercase;
      width: 100%;
    }
    .mobile-ticket-bar a b { font-size: 1rem; }
  }
</style>
