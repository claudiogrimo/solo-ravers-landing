---
import MobileTicketBar from '../components/MobileTicketBar.astro';

interface Props {
  title: string;
  description: string;
  ticketUrl: string;
  date: string;
  ogTitle?: string;
  ogDescription?: string;
  mobileTicketHref?: string;
  mobileTicketExternal?: boolean;
}

const {
  title,
  description,
  ticketUrl,
  date,
  ogTitle,
  ogDescription,
  mobileTicketHref = ticketUrl,
  mobileTicketExternal = true,
} = Astro.props;

const canonicalUrl = 'https://soloravers.net/';
const socialTitle = ogTitle ?? 'Solo Ravers Invite — Amsterdam, 21 Oct 2026';
const socialDescription =
  ogDescription ??
  'Two venues. One long night. ADE round two in De Pijp — pre-drinks at Tapmarin, main party at Huis van Iemand Anders. Tickets on Resident Advisor.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#11110f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>

    <!-- Open Graph / social preview -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Solo Ravers" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${canonicalUrl}og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Solo Ravers Invite — Amsterdam, 21 Oct 2026" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={`${canonicalUrl}og-image.png`} />
  </head>
  <body>
    <slot />
    <MobileTicketBar ticketUrl={ticketUrl} date={date} ticketHref={mobileTicketHref} ticketExternal={mobileTicketExternal} />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --ink: #11110f;
    --paper: #f1eee4;
    --muted: #b9b6ad;
    --acid: #d7ff00;
    --red: #ff4b2b;
    --line: rgba(241, 238, 228, 0.3);
    --display: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
    --body: 'Arial Narrow', Arial, sans-serif;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: var(--ink); }
  body { margin: 0; background: var(--ink); color: var(--paper); font-family: var(--body); }
  a { color: inherit; }
  img { display: block; max-width: 100%; }
  ::selection { background: var(--acid); color: var(--ink); }
  @media (max-width: 760px) { body { padding-bottom: 4.4rem; } }
</style>
