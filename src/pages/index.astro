---
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Lineup from '../components/Lineup.astro';
import Marquee from '../components/Marquee.astro';
import MotionController from '../components/MotionController.astro';
import Tickets from '../components/Tickets.astro';
import TwoParts from '../components/TwoParts.astro';
import Venue from '../components/Venue.astro';
import VoteSection from '../components/VoteSection.astro';
import { event } from '../data/event';
import BaseLayout from '../layouts/BaseLayout.astro';

const access = {
  freePassUrl: event.ticketUrl,
  paidTicketUrl: 'https://tally.so/r/dW7Kro',
  voteUrl: 'https://tally.so/r/LZ8vLl',
};

const contestPlayers = [
  {
    artist: 'Clodol',
    src: 'https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/tracks/soundcloud%253Atracks%253A2206884571&color=%23ff5500&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true&visual=true',
  },
  {
    artist: 'oatmilk',
    src: 'https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/tracks/soundcloud%253Atracks%253A2260920482&color=%23ff5500&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true&visual=true',
  },
  {
    artist: 'DE//SIRE',
    src: 'https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/tracks/soundcloud%253Atracks%253A2202301967&color=%23ff5500&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true&visual=true',
  },
  {
    artist: 'SLURPiSS',
    src: 'https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/tracks/soundcloud%253Atracks%253A2209993706&color=%23ff5500&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true&visual=true',
  },
];
---

<BaseLayout title={`${event.title} | Solo Ravers`} description={`Solo Ravers returns to ${event.city} on ${event.dateLabel}.`} ticketUrl={event.ticketUrl} date={event.dateLabel} mobileTicketHref="#tickets" mobileTicketExternal={false}>
  <main>
    <Hero title={event.title} date={event.dateLabel} city={event.city} ticketUrl={event.ticketUrl} ticketHref="#tickets" ticketExternal={false} primaryCtaVariant="red" />
    <Marquee items={['Solo Ravers', 'Amsterdam', '21 Oct 2026', 'De Pijp']} />
    <About text={event.description} genre={event.genre} />
    <TwoParts parts={event.parts} showActions={false} />
    <Lineup artists={event.lineup} voteHref="#vote" players={contestPlayers} b2b={event.b2b} />
    <VoteSection voteUrl={access.voteUrl} />
    <Venue address={event.parts[1].address} mapsUrl={event.mapsUrl} />
    <Tickets ticketUrl={access.freePassUrl} paidTicketUrl={access.paidTicketUrl} voteUrl={access.voteUrl} preview={true} />
  </main>
  <Footer promoter={event.promoter} />
  <MotionController />
</BaseLayout>
